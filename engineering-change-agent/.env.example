# Copy to `.env` and fill in your resource. These are NOT secrets — the endpoint
# is public and authentication uses Microsoft Entra (no API key).
#
# Your identity needs the "Cognitive Services OpenAI User" role on the resource.
# Sign in first with: az login

# Foundry / Azure OpenAI v1 (OpenAI-compatible) endpoint. Must reach /openai/v1.
AZURE_OPENAI_BASE_URL=https://YOUR-RESOURCE.openai.azure.com/openai/v1/

# The model *deployment* name (not the base model name).
AZURE_OPENAI_DEPLOYMENT=gpt-5.5

# Entra token scope for the v1 endpoint (current Microsoft Learn default).
AZURE_OPENAI_TOKEN_SCOPE=https://ai.azure.com/.default
